# Model weights (multi-GB). Verify downloads against models\expected-sha256.txt, which stays tracked.
*.gguf

# llama.cpp release binaries (cpu\, vulkan\) and the zips they were unpacked from
/llama.cpp/

# Server runtime state, rewritten by start.ps1 / stop.ps1 on every run
/logs/server*.log
/logs/server.pid
/logs/server.profile.json

# Per-run outputs of bench.ps1, eval.ps1 and rag-eval.ps1 (git add -f one you want to keep as a baseline).
# logs\bench-*.txt stay tracked: README.md cites them as the baseline benchmarks.
/logs/bench/
/logs/eval/
/logs/rag-eval/

# Claude Code worktrees live inside the repo root
/.claude/worktrees/

# Platform: generated secrets, backups, runtime state
platform/.env
platform/secrets/*
!platform/secrets/README.md
platform/backups/*
!platform/backups/.gitkeep
platform/config/runtime/
platform/compose.mounts.yaml
platform/bench/results/
__pycache__/
*.pyc
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/

# Editor / OS noise
.vscode/
*.swp
Thumbs.db
Desktop.ini
